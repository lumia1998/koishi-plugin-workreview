{
  "name": "koishi-plugin-workreview",
  "description": "Work_Review activity report plugin powered by ChatLuna",
  "version": "0.6.1",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "resources"
  ],
  "license": "AGPL-3.0",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "chatluna",
    "workreview",
    "activitywatch"
  ],
  "dependencies": {
    "@langchain/core": "^0.3.80"
  },
  "devDependencies": {
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": "^1.3.9",
    "koishi-plugin-cron": "^3.1.0",
    "koishi-plugin-puppeteer": "^3.9.0",
    "typescript": "^5.9.3",
    "yakumo": "^1.0.0",
    "yakumo-esbuild": "^1.0.0",
    "yakumo-tsc": "^1.0.0"
  },
  "peerDependencies": {
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": "^1.3.0-alpha.49",
    "koishi-plugin-puppeteer": "^3.9.0",
    "koishi-plugin-cron": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-cron": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npx yakumo build",
    "typecheck": "npx tsc --noEmit"
  },
  "koishi": {
    "category": "ai",
    "description": {
      "zh": "对接 Work_Review 活动日报，并使用 ChatLuna 生成分析图片。"
    },
    "service": {
      "required": [
        "chatluna",
        "puppeteer"
      ],
      "optional": [
        "cron"
      ]
    }
  }
}
